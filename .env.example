# ══════════════════════════════════════════════════════════════
#  NUMINATION — Variables de entorno (PLANTILLA)
# ══════════════════════════════════════════════════════════════
#  Este archivo NO contiene valores reales, solo los nombres.
#  Para desarrollo local: copia el contenido a `env.local.js`
#  con la forma `export const TEST_KEYS = { ... }`.
#
#  En Vercel NO se usa este archivo: se configuran con
#  `vercel env pull` o desde el dashboard del proyecto.
#
#  ⚠️  NUNCA subas tus keys reales a GitHub.
# ══════════════════════════════════════════════════════════════


# ─── Servidor ───────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── Base de datos (Supabase) ────────────────────────────────
# ⚠️  SERVICE_KEY, no la anon key. Con la anon key los INSERT
#     fallan con "row-level security policy".
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ⚠️  Puerto 6543 = transaction pooler (Vercel serverless).
#     El 5432 directo se agota con muchas conexiones.
DATABASE_URL=

# ─── Sesiones ───────────────────────────────────────────────
# Firma los JWT de las cookies. Si lo cambias, cierras todas
# las sesiones abiertas. Generar con: openssl rand -hex 32
JWT_SECRET=


# ─── Login con Google (Identity Services) ───────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── Login con GitHub (OAuth App) ───────────────────────────
# https://github.com/settings/developers
# El scope "user:email" es OBLIGATORIO: sin él el backend no
# puede leer el email real del usuario.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ─── Rate limiting (Upstash Redis) ──────────────────────────
# https://console.upstash.com
# Sin esto los límites no aplican: el aviso sale en el log
# pero el sitio sigue funcionando.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─── Motores de IA (cascada con failover) ───────────────────
# Orden para TEXTO:   groq → gemini → kimi
# Orden para ARCHIVOS: gemini → kimi → groq

# Motor 1 — Groq (rápido, ~2-3s). El primero en responder texto.
# https://console.groq.com/keys
GROQ_API_KEY=

# Motor 2 — Gemini (3 keys con rotación y cooldown de 60s).
# https://aistudio.google.com/app/apikey
# Con una sola key se pierde la rotación y la cascada se
# debilita mucho en hora pico.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Motor 3 — Kimi K3, servido por el API de NVIDIA.
# https://build.nvidia.com
NVIDIA_API_KEY=


# ─── Diagnóstico ────────────────────────────────────────────
# Poner en 1 enciende los LOG.debug (mucho ruido, solo local).
# DEBUG=1
