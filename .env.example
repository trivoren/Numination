# ══════════════════════════════════════════════════════════════
#  NUMINATION — Variables de entorno
# ══════════════════════════════════════════════════════════════
#
#  Este archivo es una PLANTILLA. NO contiene valores reales.
#  NO lo uses directamente. Crea una copia llamada `.env`
#  (o `env.local.js`) con tus valores reales.
#
#  ⚠️  NUNCA subas el archivo con tus keys reales a GitHub.
# ══════════════════════════════════════════════════════════════

# ─── Servidor ───
# Puerto donde corre el servidor (default: 8080)
PORT=8080

# Entorno: development | production
NODE_ENV=development

# ─── API Keys de IA ───
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_key_de_gemini_aqui

# Mistral AI — https://console.mistral.ai
MISTRAL_API_KEY=tu_key_de_mistral_aqui

# ─── Firebase (opcional, para roadmap futuro) ───
# FIREBASE_PROJECT_ID=tu_proyecto_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── CORS (opcional en producción) ───
# Lista separada por comas de dominios permitidos
# ALLOWED_ORIGINS=https://numination.app,https://www.numination.app